POST_INTERVAL = 1800  # 30 минут в секундах

# Настройка логирования
logging.basicConfig(level=logging.INFO)

# Инициализация бота
bot = Bot(token=TOKEN)
dp = Dispatcher(bot)

async def send_post():
    while True:
        product = random.choice(PRODUCTS)
        seller = random.choice(SELLERS)
        caption = f"{product['text']}\n\n🔗 Купить у {seller['name']}: {seller['link']}"
        
        for channel in CHANNELS:
            try:
                await bot.send_photo(chat_id=channel, photo=product['image'], caption=caption)
                logging.info(f"Отправлен пост в {channel}")
            except Exception as e:
                logging.error(f"Ошибка при отправке в {channel}: {e}")
        
        await asyncio.sleep(POST_INTERVAL)  # Ждем следующий цикл

@dp.message_handler(commands=['start'])
async def start_command(message: types.Message):
    await message.reply("Бот запущен! Он автоматически публикует посты по расписанию.")

if __name__ == "__main__":
    loop = asyncio.get_event_loop()
    loop.create_task(send_post())
    executor.start_polling(dp, skip_updates=True)
